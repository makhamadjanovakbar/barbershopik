generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Barber {
  id         Int                 @id @default(autoincrement())
  name       String
  avatarUrl  String?
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  schedules  WorkSchedule[]
  exceptions ScheduleException[]
  bookings   Booking[]
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  durationMin Int
  price       Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
}

model WorkSchedule {
  id        Int      @id @default(autoincrement())
  barberId  Int
  /** 0 = Sunday, 1 = Monday, …, 6 = Saturday */
  weekday   Int
  /** "HH:MM" */
  startTime String
  /** "HH:MM" */
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
}

model ScheduleException {
  id        Int      @id @default(autoincrement())
  barberId  Int
  /** "YYYY-MM-DD" */
  date      String
  /** null = весь день не работает */
  startTime String?
  endTime   String?
  isDayOff  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date])
}

model Booking {
  id          Int      @id @default(autoincrement())
  barberId    Int
  serviceId   Int
  clientName  String
  clientPhone String
  telegramId  String?
  /** ISO datetime */
  startsAt    DateTime
  /** ISO datetime */
  endsAt      DateTime
  /** "confirmed" | "cancelled" */
  status      String   @default("confirmed")
  /** "web" | "telegram" */
  source      String   @default("web")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barber      Barber   @relation(fields: [barberId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])

  /** Защита от двойной записи на уровне БД */
  @@unique([barberId, startsAt])
  @@index([startsAt])
  @@index([barberId, startsAt, status])
  @@index([telegramId])
}