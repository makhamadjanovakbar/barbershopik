# ─────────────────────────────────────────────────────────────
# База данных (Prisma + SQLite)
# ─────────────────────────────────────────────────────────────
# Файл БД будет создан в prisma/dev.db при первой миграции.
# Менять не нужно — это локальная файловая база.
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Админка
# ─────────────────────────────────────────────────────────────
# Пароль для входа в /admin. Придумай свой — используется как
# секрет для подписи сессионной cookie (HMAC-SHA256).
ADMIN_PASSWORD="change-me-please"

# ─────────────────────────────────────────────────────────────
# Telegram-бот «Барбершопик»
# ─────────────────────────────────────────────────────────────
# Токен получи у @BotFather в Telegram.
# Пример: набери /newbot, придумай имя и юзернейм с окончанием «bot».
TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenReplaceMe"

# Юзернейм бота без @ — показывается на лендинге в блоке «Контакты».
NEXT_PUBLIC_BOT_USERNAME="barbershopik_bot"